// Wardrobe — Prisma schema (PostgreSQL variant for production / Vercel).
// Mirror of prisma/schema.prisma (the SQLite dev schema): the models are
// identical and use only portable types, so keep the two in sync — only the
// datasource provider differs. Enum-like fields remain validated strings and
// colorTags stays a JSON-encoded string for parity with local dev.
// Used by `npm run vercel-build` (generate + db push against Postgres).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  handle       String   @unique
  avatarUrl    String?
  bio          String?
  passwordHash String? // used by the dev credentials provider; null for OAuth-only users
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collections     Collection[]
  clippedProducts Product[]       @relation("ProductAddedBy")
  following       Follow[]        @relation("Follower")
  followers       Follow[]        @relation("Following")
  likes           Like[]
  comments        Comment[]
  activity        ActivityEvent[] @relation("ActivityActor")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  website   String?
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  brandId     String
  title       String
  description String?
  price       Float?
  currency    String   @default("USD")
  imageUrl    String?
  sourceUrl   String?
  category    String   @default("other") // tops|bottoms|outerwear|footwear|accessories|dresses|other
  colorTags   String   @default("[]") // JSON-encoded string[]
  addedById   String?
  createdAt   DateTime @default(now())

  brand   Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  addedBy User?            @relation("ProductAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  items   CollectionItem[]

  @@index([brandId])
  @@index([category])
}

model Collection {
  id            String   @id @default(cuid())
  ownerId       String
  title         String
  description   String?
  coverImageUrl String?
  visibility    String   @default("public") // public|friends|private
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([ownerId])
  @@index([visibility])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  position     Int      @default(0)
  note         String?
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  targetType String // collection|collectionItem
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Comment {
  id         String   @id @default(cuid())
  userId     String
  targetType String // collection|collectionItem
  targetId   String
  body       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  actorId    String
  verb       String // created_collection|added_item|liked|commented|followed
  objectType String // collection|collectionItem|user
  objectId   String
  metadata   String   @default("{}") // JSON: denormalized labels for cheap feed rendering
  createdAt  DateTime @default(now())

  actor User @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
}
