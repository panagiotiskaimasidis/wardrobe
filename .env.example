# ---------------------------------------------------------------------------
# Wardrobe environment variables. Copy this file to `.env` and adjust.
# The app runs in dev with these defaults and NO external services required.
# ---------------------------------------------------------------------------

# Database connection string.
# Dev default: a local SQLite file at the project root (zero setup).
# For Postgres in production, change the datasource provider in
# prisma/schema.prisma to "postgresql" and set this to your connection string,
# then swap the driver adapter in src/lib/db.ts (see README).
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example — the app auto-detects the adapter by scheme:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wardrobe?sslmode=require"

# Secret used to sign session cookies (JWT, HS256).
# Generate one with: `openssl rand -base64 32`
# A dev fallback is used if unset, but ALWAYS set this in production.
AUTH_SECRET="dev-only-insecure-secret-change-me"

# Public base URL of the deployment. Used for metadata, robots.txt, sitemap.xml.
# In dev the default localhost URL is fine.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional: Google OAuth (stubbed) -------------------------------------
# The app works fully without these using the dev credentials login.
# When both are present, a "Continue with Google" option can be enabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: URL clipper tuning -----------------------------------------
# User-Agent sent when fetching public product-page metadata.
CLIPPER_USER_AGENT="WardrobeBot/1.0 (+https://github.com/panagiotiskaimasidis/wardrobe)"
